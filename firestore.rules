rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      
      match /store/{key} {
        allow read, write: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      }

      match /{allChildren=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    function isValidSharedLink(data) {
      return data.keys().hasAll(['type', 'data', 'createdBy', 'createdAt']) && 
             data.keys().size() == 4 &&
             data.type is string && data.type.size() <= 50 &&
             data.data is string && data.data.size() <= 1000000 &&
             data.createdBy is string && data.createdBy == request.auth.uid &&
             data.createdAt == request.time;
    }

    match /shared_links/{linkId} {
      // Only direct document access by unguessable ID; listing must stay disabled.
      allow get: if isValidId(linkId) && linkId.size() >= 20;
      allow list: if false;
      allow create: if isSignedIn() && isValidId(linkId) && linkId.size() >= 20 && isValidSharedLink(request.resource.data);
      allow update, delete: if false; // Immutable after creation
    }

    function isValidGpsRoom(data) {
      return data.keys().hasOnly(['roomId', 'ownerUid', 'members', 'activeMembers', 'joinCode', 'primaryLocation', 'secondaryLocation', 'messages', 'geofenceZones', 'primaryName', 'secondaryName', 'updatedAt', 'createdAt']) &&
             (!('roomId' in data) || (data.roomId is string && data.roomId.size() <= 128)) &&
             (!('ownerUid' in data) || (data.ownerUid is string && data.ownerUid.size() <= 128)) &&
             (!('members' in data) || (data.members is list && data.members.size() <= 10)) &&
             (!('activeMembers' in data) || (data.activeMembers is list && data.activeMembers.size() <= 10)) &&
             (!('joinCode' in data) || (data.joinCode is string && data.joinCode.size() <= 128)) &&
             (!('primaryLocation' in data) || (data.primaryLocation is string && data.primaryLocation.size() <= 100000)) &&
             (!('secondaryLocation' in data) || (data.secondaryLocation is string && data.secondaryLocation.size() <= 100000)) &&
             (!('messages' in data) || (data.messages is string && data.messages.size() <= 200000)) &&
             (!('geofenceZones' in data) || (data.geofenceZones is string && data.geofenceZones.size() <= 50000)) &&
             (!('primaryName' in data) || (data.primaryName is string && data.primaryName.size() <= 100)) &&
             (!('secondaryName' in data) || (data.secondaryName is string && data.secondaryName.size() <= 100));
    }

    match /gps_rooms/{roomId} {
      // Read: strictly authenticated members or owner
      allow get: if isSignedIn() && isValidId(roomId) && (
        (resource != null && (
          ('members' in resource.data && request.auth.uid in resource.data.members) ||
          ('ownerUid' in resource.data && resource.data.ownerUid == request.auth.uid)
        ))
      );

      allow list: if isSignedIn() && (
        ('members' in resource.data && request.auth.uid in resource.data.members) ||
        ('ownerUid' in resource.data && resource.data.ownerUid == request.auth.uid)
      );

      // Create: only authenticated user creating as owner and included in members
      allow create: if isSignedIn() && isValidId(roomId) && isValidGpsRoom(request.resource.data) &&
        ('ownerUid' in request.resource.data && request.resource.data.ownerUid == request.auth.uid) &&
        ('members' in request.resource.data && request.auth.uid in request.resource.data.members);

      // Update: members updating location/messages, or new member joining with valid joinCode
      allow update: if isSignedIn() && isValidId(roomId) && isValidGpsRoom(request.resource.data) && (
        // Existing member or owner updating state
        (
          resource != null && (
            ('members' in resource.data && request.auth.uid in resource.data.members) ||
            ('ownerUid' in resource.data && resource.data.ownerUid == request.auth.uid)
          ) &&
          (!('ownerUid' in resource.data) || !('ownerUid' in request.resource.data) || request.resource.data.ownerUid == resource.data.ownerUid)
        ) ||
        // Joining room: adding self to members when joinCode matches
        (
          resource != null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'activeMembers', 'updatedAt', 'secondaryName']) &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.auth.uid in request.resource.data.members &&
          request.resource.data.members.size() <= 10 &&
          (
            ('joinCode' in resource.data && resource.data.joinCode == roomId) ||
            ('joinCode' in resource.data && 'joinCode' in request.resource.data && resource.data.joinCode == request.resource.data.joinCode) ||
            !('joinCode' in resource.data)
          )
        )
      );

      // Delete: only room owner can delete
      allow delete: if isSignedIn() && isValidId(roomId) && resource != null && (
        resource.data.ownerUid == request.auth.uid
      );
    }
  }
}
