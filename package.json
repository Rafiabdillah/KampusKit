    "firebase": "^12.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.563.0",
    "motion": "^13.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
